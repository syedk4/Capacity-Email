# SharePoint/Azure AD Configuration
# Copy this file to .env and fill in your actual values

# Azure AD Tenant ID (from Azure Portal > Azure Active Directory > Overview)
AZURE_TENANT_ID=your-tenant-id-here

# Azure AD Application (Client) ID (from App Registration)
AZURE_CLIENT_ID=your-client-id-here

# Azure AD Client Secret (from App Registration > Certificates & secrets)
AZURE_CLIENT_SECRET=your-client-secret-here

# SharePoint Site URL (e.g., https://ashleyfurniture.sharepoint.com/sites/IT-Finance-IndiaFinanceTeam)
SHAREPOINT_SITE_URL=your-sharepoint-site-url-here

# SharePoint File Path (relative path from site root, e.g., /Shared Documents/Daily Updates/2026- India Finance team Daily work status.xlsx)
SHAREPOINT_FILE_PATH=/your/file/path/here.xlsx

# Email Configuration (from existing setup)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SENDER_EMAIL=DONOTREPLY@ashleyfurniture.com
SENDER_PASSWORD=your-email-password-here
SCRUM_MASTER_EMAIL=slatheef@ashleyfurniture.com

